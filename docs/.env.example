# =============================================================================
# Paladeium — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
NODE_ENV=development                              # development | staging | production
PORT=4000                                         # API server port
API_URL=http://localhost:4000                     # Full API base URL (used by frontend apps)
LENS_URL=http://localhost:3000                    # Customer AR Lens URL
POS_URL=http://localhost:3001                     # Restaurant POS URL
ADMIN_URL=http://localhost:3002                   # Admin panel URL

# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL + TimescaleDB
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://paladeium:password@localhost:5432/paladeium_dev
DATABASE_URL_READONLY=postgresql://paladeium_ro:password@localhost:5432/paladeium_dev

# Connection pool
DB_POOL_MIN=2
DB_POOL_MAX=20

# For local Docker dev (matches docker-compose.yml)
POSTGRES_USER=paladeium
POSTGRES_PASSWORD=password
POSTGRES_DB=paladeium_dev
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=                                   # Leave blank for local dev
REDIS_DB=0

# Cache TTL (seconds)
REDIS_MENU_CACHE_TTL=300                          # 5 minutes
REDIS_SESSION_TTL=86400                           # 24 hours

# -----------------------------------------------------------------------------
# AUTH — Clerk
# -----------------------------------------------------------------------------
# Get these from https://dashboard.clerk.com → Your app → API Keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret (from Clerk Dashboard → Webhooks)
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT verification
CLERK_JWT_KEY=                                    # Leave blank to auto-fetch from Clerk

# -----------------------------------------------------------------------------
# PAYMENTS — Razorpay
# -----------------------------------------------------------------------------
# Get these from https://dashboard.razorpay.com → Account & Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx             # Use rzp_live_ in production
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret (from Razorpay Dashboard → Webhooks)
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# OBJECT STORAGE — Cloudflare R2
# -----------------------------------------------------------------------------
# Get these from Cloudflare Dashboard → R2 → Manage API Tokens
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=paladeium-assets
R2_ENDPOINT=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com

# CDN URL for public asset delivery
CDN_URL=https://cdn.paladeium.app
# For local dev, use the R2 dev URL or a local MinIO instance:
# CDN_URL=http://localhost:9000/paladeium-assets

# Signed URL expiry (seconds)
R2_SIGNED_URL_EXPIRY=3600                         # 1 hour

# -----------------------------------------------------------------------------
# SOCKET.IO
# -----------------------------------------------------------------------------
SOCKET_PORT=4001                                  # Can be same as API port or separate
SOCKET_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# -----------------------------------------------------------------------------
# EMAIL (optional — for receipts and notifications)
# -----------------------------------------------------------------------------
# Resend (recommended): https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@paladeium.app
EMAIL_FROM_NAME=Paladeium

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_PUBLIC_RPM=100                         # Requests per minute for public endpoints
RATE_LIMIT_AUTH_RPM=300                           # Requests per minute for authenticated users

# -----------------------------------------------------------------------------
# AR TARGET COMPILATION
# -----------------------------------------------------------------------------
# Path to Chromium binary for Puppeteer (set in production if not auto-detected)
PUPPETEER_EXECUTABLE_PATH=                        # e.g. /usr/bin/chromium-browser
PUPPETEER_HEADLESS=true

# Max concurrent compilation jobs
TARGETS_COMPILER_CONCURRENCY=2

# -----------------------------------------------------------------------------
# MONITORING
# -----------------------------------------------------------------------------
# Sentry (errors) — https://sentry.io
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development

# PostHog (product analytics) — https://posthog.com
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
# Toggle features without redeployment
FEATURE_LOYALTY_PROGRAMME=false
FEATURE_MULTI_BRANCH=false
FEATURE_SELF_SERVICE_MODELS=false
FEATURE_WHATSAPP_NOTIFICATIONS=false

# -----------------------------------------------------------------------------
# FRONTEND — Next.js POS (prefix NEXT_PUBLIC_ to expose to browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001
NEXT_PUBLIC_CDN_URL=https://cdn.paladeium.app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# DOCKER COMPOSE (local dev shortcuts)
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=paladeium

# =============================================================================
# PRODUCTION CHECKLIST
# Before going live, verify:
#   [ ] NODE_ENV=production
#   [ ] DATABASE_URL points to managed PostgreSQL (Railway/RDS/Supabase)
#   [ ] REDIS_URL points to managed Redis
#   [ ] All *_SECRET and *_KEY values are production credentials
#   [ ] RAZORPAY_KEY_ID starts with rzp_live_
#   [ ] CDN_URL points to Cloudflare R2 CDN
#   [ ] CLERK_SECRET_KEY is production key
#   [ ] Rate limits are appropriate for expected traffic
#   [ ] SENTRY_DSN is set and environment = production
# =============================================================================
